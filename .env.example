EVENTS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only needed for temporary credentials (SSO or an assumed role)
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=
# Snowflake connection for Airflow (key-pair auth, private key base64-encoded)
AIRFLOW_CONN_SNOWFLAKE_DEFAULT={"conn_type":"snowflake","login":"<user>","extra":{"account":"<account>","warehouse":"<warehouse>","role":"<role>","private_key_content":"<base64 private key>"}}